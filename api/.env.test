# Environnement de test : base SQLite jetable et clés JWT générées à la volée (aucun secret réel).
KERNEL_CLASS='App\Kernel'
APP_SECRET='test-secret-not-used-in-prod'
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
JWT_SECRET_KEY=%kernel.project_dir%/var/jwt-test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/jwt-test/public.pem
JWT_PASSPHRASE=test-only-passphrase
